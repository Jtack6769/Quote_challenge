  },
  {
    "id": "quotes 20",
    "difficulty": "Easy",
    "quote": "He killed them with their love. That's how it is every day, all over the world.",
    "franchise": "The Green Mile",
    "context": "John Coffey explaining the tragic reality of the crime he was falsely accused of committing"
  },
  {
    "id": "quotes 21",
    "difficulty": "Medium",
